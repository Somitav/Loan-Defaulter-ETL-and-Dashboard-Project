--staging table creation--
create table "loan_defaulter_stg" (
"id" varchar,
"year" varchar ,
"loan_limit" varchar ,
"Gender" varchar ,
"loan_type" varchar ,
"loan_purpose" varchar ,
"Business_or_commerical" varchar ,
"loan_amount" float ,
"rate_of_interest" float ,
"upfront_charge" float ,
"property_value" float ,
"occupancy_type" varchar ,
"Income" float ,
"credit_type" varchar ,
"credit_score" int ,
"co_applicant_credit_type" varchar ,
"age" varchar ,
"LTV" FLOAT ,
"Region" varchar ,
"Status" varchar ) ;


-- selecting all records from the table -- 
select * from loan_defaulter_stg ;


--validation ---

--checking loan amount matching in source --
select sum("loan_amount") from loan_defaulter_stg ;

-- checking total count of records matching with source--
select count("id") from loan_defaulter_stg ;
